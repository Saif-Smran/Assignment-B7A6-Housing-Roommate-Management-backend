{
	"info": {
		"_postman_id": "b7a6-housing-roommate-platform-api",
		"name": "Housing & Roommate Management Platform API",
		"description": "Postman collection for Housing & Roommate Management Platform API. Includes Authentication, Profile, Properties, Rooms, Applications, Maintenance, Viewing Requests, and bKash Payment Integration.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000/api",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "propertyId",
			"value": "cuid_property_id",
			"type": "string"
		},
		{
			"key": "roomId",
			"value": "cuid_room_id",
			"type": "string"
		},
		{
			"key": "applicationId",
			"value": "cuid_application_id",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "cuid_user_id",
			"type": "string"
		},
		{
			"key": "paymentId",
			"value": "cuid_payment_id",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register New User (Tenant / Owner / Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\",\n  \"phone\": \"+8801700000000\",\n  \"role\": \"TENANT\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						},
						"description": "Public route to register a new user."
					}
				},
				{
					"name": "Login User (Credential Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data) {",
									"    if (jsonData.data.accessToken) {",
									"        pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
									"    }",
									"    if (jsonData.data.refreshToken) {",
									"        pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"description": "Public route to authenticate credentials and receive JWT accessToken and set HttpOnly refreshToken cookie."
					}
				},
				{
					"name": "Refresh Access Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/refresh-token",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "refresh-token"]
						},
						"description": "Public route to refresh JWT access token using a valid refresh token."
					}
				},
				{
					"name": "Logout User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "logout"]
						},
						"description": "Authenticated route to log out user and clear refresh token cookie."
					}
				}
			]
		},
