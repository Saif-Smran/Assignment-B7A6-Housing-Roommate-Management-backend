							"mode": "raw",
							"raw": "{\n  \"title\": \"Modern Sunset Apartment\",\n  \"description\": \"Spacious 3-bedroom flat in Dhanmondi\",\n  \"address\": \"Road 27, House 45\",\n  \"city\": \"Dhaka\",\n  \"state\": \"Dhaka\",\n  \"country\": \"Bangladesh\",\n  \"zipCode\": \"1209\",\n  \"propertyType\": \"Apartment\",\n  \"amenities\": [\"WiFi\", \"Parking\", \"Lift\", \"Generator\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/properties",
