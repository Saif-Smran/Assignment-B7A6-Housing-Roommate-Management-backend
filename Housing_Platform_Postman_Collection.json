		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "propertyId",
			"value": "cuid_property_id",
			"type": "string"
		},
		{
			"key": "roomId",
