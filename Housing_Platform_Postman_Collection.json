{
	"info": {
		"_postman_id": "b7a6-housing-roommate-platform-api",
		"name": "Housing & Roommate Management Platform API",
		"description": "Postman collection for Housing & Roommate Management Platform API. Includes Authentication, Profile, Properties, Rooms, Applications, Maintenance, Viewing Requests, and Stripe Payment Integration.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000/api",
