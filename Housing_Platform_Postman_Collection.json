		{
			"name": "7. Payments (bKash Payment Integration)",
			"item": [
				{
					"name": "Initiate bKash Rent / Deposit Payment",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"applicationId\": \"{{applicationId}}\",\n  \"amount\": 12000,\n  \"paymentMethod\": \"bKash\",\n  \"paymentType\": \"RENT\",\n  \"description\": \"Monthly rent payment via bKash gateway\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/payments/bkash/initiate",
							"host": ["{{baseUrl}}"],
							"path": ["payments", "bkash", "initiate"]
						},
						"description": "Initiates bKash payment gateway checkout URL for rent or deposit."
					}
				},
				{
					"name": "bKash Payment Callback / Execution",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/payments/bkash/callback?paymentID=PAYMENT_ID_EXAMPLE&status=success",
							"host": ["{{baseUrl}}"],
							"path": ["payments", "bkash", "callback"],
							"query": [
								{ "key": "paymentID", "value": "PAYMENT_ID_EXAMPLE" },
