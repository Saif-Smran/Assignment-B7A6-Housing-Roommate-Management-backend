        },
        {
          "name": "List Applications",
          "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/applications?page=1&limit=10&status=PENDING&sortBy=createdAt&sortOrder=desc" }
        },
        { "name": "My Applications", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/applications/my" } },
        { "name": "Applications For Property", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/applications/for-property/{{propertyId}}" } },
        { "name": "Get Application", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/applications/{{applicationId}}" } },
        {
          "name": "Update Application Status",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"status\": \"APPROVED\"\n}" }, "url": "{{baseUrl}}/api/applications/{{applicationId}}/status" }
        }
      ]
    },
    {
      "name": "Viewing Requests",
      "item": [
        { "name": "List Viewing Requests", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/viewing-requests" } },
        {
          "name": "Update Viewing Status",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONFIRMED\"\n}" }, "url": "{{baseUrl}}/api/viewing-requests/{{viewingRequestId}}/status" }
        }
      ]
    },
    {
      "name": "Maintenance",
      "item": [
        { "name": "List Maintenance Requests", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/maintenance-requests" } },
        {
          "name": "Update Maintenance Status",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"assignedTo\": \"{{userId}}\"\n}" }, "url": "{{baseUrl}}/api/maintenance-requests/{{maintenanceRequestId}}/status" }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Initiate Payment (Tenant)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"applicationId\": \"{{applicationId}}\",\n  \"amount\": 25000,\n  \"paymentType\": \"RENT\",\n  \"description\": \"November rent\",\n  \"successUrl\": \"http://localhost:3000/payment/success\",\n  \"cancelUrl\": \"http://localhost:3000/payment/cancel\"\n}" }, "url": "{{baseUrl}}/api/payments/initiate" }
        },
        { "name": "Owner Earnings", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/payments/earnings" } },
        { "name": "My Payments", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/payments/my?page=1&limit=10&status=COMPLETED&paymentType=RENT&sortBy=createdAt&sortOrder=desc" } },
        { "name": "Get Payment", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/payments/{{paymentId}}" } },
        {
          "name": "Stripe Webhook",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "stripe-signature", "value": "STRIPE_SIGNATURE" }], "body": { "mode": "raw", "raw": "{\n  \"type\": \"checkout.session.completed\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"cs_test_example\",\n      \"metadata\": {\n        \"paymentId\": \"{{paymentId}}\"\n      }\n    }\n  }\n}" }, "url": "{{baseUrl}}/api/payments/webhook" }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        { "name": "List Users", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/admin/users?page=1&limit=10&search=tenant&role=TENANT" } },
        {
          "name": "Update User Role",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"role\": \"OWNER\"\n}" }, "url": "{{baseUrl}}/api/admin/users/{{userId}}/role" }
        },
        { "name": "Dashboard Stats", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/admin/dashboard-stats" } },
        { "name": "List Properties (Admin)", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/admin/properties?page=1&limit=10" } },
        { "name": "Hard Delete Property", "request": { "method": "DELETE", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/admin/properties/{{propertyId}}" } }
      ]
